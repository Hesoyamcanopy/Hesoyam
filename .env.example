# Copy to .env and fill in. .env is gitignored; never commit a real value.

# --- deployer -----------------------------------------------------------
# Created by: npm run wallet:new
DEPLOYER_KEY=

# --- chains -------------------------------------------------------------
# The public endpoints work but are rate limited. Use Alchemy for anything real.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ARBITRUM_SEPOLIA_RPC=

# --- the token ----------------------------------------------------------
# Set this to the address Pons deploys. When set, the deploy attaches to it
# instead of deploying its own, and skips the tax setup Pons owns.
HESOYAM_TOKEN=

# --- deploy time addresses ----------------------------------------------
# The deploy REFUSES to run off a local chain without PONS_TREASURY, OPS_SAFE
# and SETTLEMENT. It falls back to the deployer address for the rest, which is
# fine locally and wrong everywhere else.

# Receives the CREATOR leg of the transfer tax, which is 4 of the 5 percent.
# This is the big one. Point it at the wallet you actually want paid.
PONS_TREASURY=

# Receives the ops slice of router revenue, 8 percent of the split. A multisig.
OPS_SAFE=

# Receives the liquidity slice, 12 percent of the split. Defaults to the
# deployer, which is not what you want in production.
LIQUIDITY_SINK=

# The reward currency, immutable in StakingVault once deployed. Get it wrong and
# the only fix is a redeploy.
#
# There is NO USDC on Robinhood Chain. The canonical stablecoin is USDG, Global
# Dollar by Paxos, 6 decimals, verified on chain 4663:
SETTLEMENT=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Allowed to reveal the beacon. Defaults to the deployer. Set it to the address
# the keeper actually signs with.
KEEPER=

# --- keeper -------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without a running keeper, players can plant but
# nothing ever resolves. See docs/OPERATIONS.md.
RPC_URL=
BEACON_ADDRESS=
KEEPER_KEY=
KEEPER_SECRET=
CHAIN_LENGTH=100000
REVEAL_INTERVAL_MS=300000
KEEPER_PORT=8788

# --- beacon commit, one shot -------------------------------------------
# Produced by: npm run keeper:head. Consumed by: npm run beacon:setup.
# commitChain can never be called twice. A wrong head bricks the game.
BEACON_HEAD=
REVEALER=

# --- indexer ------------------------------------------------------------
# A session pooler, NOT the transaction pooler on port 6543.
DATABASE_URL=
CONFIRMATIONS=
# How often to poll for new blocks, milliseconds.
POLL_MS=
# Local only. Where PGlite keeps its files when DATABASE_URL is unset.
PGLITE_DIR=

# --- presence -----------------------------------------------------------
REALTIME_PORT=8787
# A room fills to this many people, then the next joiner opens a new shard of the
# same room. Shards are also the unit of horizontal scale: a second presence
# process takes different ones and nothing is shared between them.
SHARD_CAPACITY=48
# Metres. You are only told about people this close. Wider than the room diagonal
# and interest management stops doing anything.
INTEREST_RADIUS=14
# Ten a second. The client interpolates, so more than this buys nothing visible.
TICK_MS=100

# --- web (public, shipped to the browser) -------------------------------
NEXT_PUBLIC_DEFAULT_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC=
NEXT_PUBLIC_REALTIME_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC=
# error | warn | info | debug. Defaults to error.
NEXT_PUBLIC_LOG_LEVEL=

# Escape hatch for a chain that is not one of the four built in. Leave every one
# of these blank unless the launch chain changes; setting only some of them
# registers a chain with no working RPC.
NEXT_PUBLIC_TARGET_CHAIN_ID=
NEXT_PUBLIC_TARGET_CHAIN_NAME=
NEXT_PUBLIC_TARGET_RPC=
NEXT_PUBLIC_TARGET_EXPLORER=
# Flip to 1 once the wallet paths have been watched in report-only mode.
CSP_ENFORCE=
