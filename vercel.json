{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm install --no-audit --no-fund",
      "buildCommand": "npm run compile -w @hesoyam/contracts && npm run generate -w @hesoyam/sdk && npm run build"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
