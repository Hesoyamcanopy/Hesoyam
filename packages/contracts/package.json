{
  "name": "@hesoyam/contracts",
  "version": "0.1.0",
  "description": "On-chain cannabis growing, trading and staking. Rewards funded by realized revenue.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js",
    "node": "hardhat node",
    "lint": "solhint \"contracts/**/*.sol\" --max-warnings 0",
    "coverage": "hardhat coverage && node scripts/check-coverage.js",
