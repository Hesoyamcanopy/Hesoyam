    "deploy:target": "hardhat run scripts/deploy.js --network target",
    "seed": "hardhat run scripts/seed.js --network localhost",
    "flywheel": "hardhat run scripts/flywheel.js --network localhost",
    "art": "hardhat run scripts/plotart.js --network localhost",
    "wallet:check": "hardhat run scripts/wallet-check.js",
    "beacon:setup": "hardhat run scripts/beacon-setup.js",
    "smoke": "hardhat run scripts/smoke.js --network localhost",
    "demo": "hardhat run scripts/demo.js --network localhost",
    "warp": "hardhat run scripts/warp.js --network localhost",
    "faucet:deploy": "hardhat run scripts/faucet-deploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "solhint": "^5.2.0",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^16.6.1"
  },
  "overrides": {
