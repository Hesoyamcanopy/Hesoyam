# Copy to .env and fill in. Never commit .env.
# The deploy script refuses to run against a non local network unless the addresses
# below are set, so a half configured deployment fails before it spends gas.

# Deployer. Use a fresh key that holds only what the deployment needs.
DEPLOYER_KEY=

# RPC endpoints
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
TARGET_RPC=
TARGET_CHAIN_ID=

# Receives the CREATOR leg of the transfer tax, 4 of the 5 percent. The other
# 1 percent is the protocol leg and goes to the RevenueRouter automatically.
PONS_TREASURY=

# Timelocked multisig that receives the operations allocation.
OPS_SAFE=

# Where the liquidity top up allocation is sent.
LIQUIDITY_SINK=

# Address allowed to update Dispensary reference prices.
KEEPER=

# Real settlement token on the target chain. Leave blank on a local chain and the
# script deploys a mock for you.
SETTLEMENT=
