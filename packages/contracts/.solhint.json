{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "0.8.24"
    ],
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "max-line-length": [
      "warn",
      120
    ],
    "no-empty-blocks": "off",
    "no-inline-assembly": "off",
    "reason-string": "off",
    "gas-custom-errors": "off",
    "ordering": "off",
    "one-contract-per-file": "off",
    "immutable-vars-naming": "off",
    "max-states-count": [
      "warn",
      20
    ]
  }
}
